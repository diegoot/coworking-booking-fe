# Base URL of the Coworking Booking API, exposed to the browser.
# Used by client-side code that needs to call the API directly.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only base URL for the same API, used by Server Components,
# Server Actions and Route Handlers. Defaults to NEXT_PUBLIC_API_URL if
# unset, but kept separate so server-side calls can target an internal
# network address (e.g. inside Docker/a private network) that differs
# from the publicly reachable one used by the browser.
API_URL=http://localhost:4000
