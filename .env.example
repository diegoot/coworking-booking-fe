# Base URL the app's server-side code (Server Components, Server
# Actions, Route Handlers) uses to reach the Coworking Booking API.
# Set this.
API_URL=http://localhost:4000

# Fallback used only if API_URL is unset. No client-side code currently
# calls the API directly despite the NEXT_PUBLIC_ prefix — safe to leave
# unset if API_URL is set.
NEXT_PUBLIC_API_URL=http://localhost:4000
